[
 {
  "start": 5.2,
  "end": 7.2,
  "text": "我是一個光棍"
 },
 {
  "start": 7.2,
  "end": 8.7,
  "text": "沒有房貸"
 },
 {
  "start": 8.7,
  "end": 10.2,
  "text": "沒有遮帶"
 },
 {
  "start": 10.2,
  "end": 12.2,
  "text": "沒有老婆"
 },
 {
  "start": 12.2,
  "end": 14.2,
  "text": "沒有後代"
 },
 {
  "start": 14.2,
  "end": 16.2,
  "text": "不出意外的話"
 },
 {
  "start": 16.2,
  "end": 21.3,
  "text": "我家以後菜也沒人了"
 },
 {
  "start": 21.3,
  "end": 23.3,
  "text": "因為沒有老婆"
 },
 {
  "start": 23.3,
  "end": 25.3,
  "text": "一個人生活"
 },
 {
  "start": 25.3,
  "end": 31.8,
  "text": "今天就找一個古瓜來吃"
 },
 {
  "start": 31.8,
  "end": 33.8,
  "text": "今天吃素菜"
 },
 {
  "start": 33.8,
  "end": 34.8,
  "text": "沒有用"
 },
 {
  "start": 34.8,
  "end": 176.1,
  "text": "39歲了"
 },
 {
  "start": 176.1,
  "end": 179.4,
  "text": "找不到老婆"
 },
 {
  "start": 179.4,
  "end": 181.4,
  "text": "每天一個人生活"
 },
 {
  "start": 181.4,
  "end": 183.4,
  "text": "我每天面對的這個"
 },
 {
  "start": 183.4,
  "end": 186.4,
  "text": "工房紙發胎"
 },
 {
  "start": 186.4,
  "end": 188.4,
  "text": "因為沒有老婆"
 },
 {
  "start": 188.4,
  "end": 194.1,
  "text": "一個人待在這個租房裡面"
 },
 {
  "start": 194.1,
  "end": 196.1,
  "text": "每天就是對著這個"
 },
 {
  "start": 196.1,
  "end": 198.1,
  "text": "租房紙發胎"
 },
 {
  "start": 198.1,
  "end": 201.1,
  "text": "冷冷清清的"
 },
 {
  "start": 201.1,
  "end": 203.1,
  "text": "沒辦法"
 },
 {
  "start": 203.1,
  "end": 205.1,
  "text": "找不到老婆"
 },
 {
  "start": 205.1,
  "end": 208.8,
  "text": "又沒有後代"
 },
 {
  "start": 208.8,
  "end": 210.8,
  "text": "沒有後代"
 },
 {
  "start": 210.8,
  "end": 212.8,
  "text": "還有希望"
 },
 {
  "start": 212.8,
  "end": 214.8,
  "text": "沒有後代"
 },
 {
  "start": 214.8,
  "end": 216.8,
  "text": "什麼希望都沒有"
 },
 {
  "start": 216.8,
  "end": 220.8,
  "text": "就是為個人而活"
 },
 {
  "start": 220.8,
  "end": 222.8,
  "text": "現在想找一個好的女人"
 },
 {
  "start": 222.8,
  "end": 225.3,
  "text": "太難"
 },
 {
  "start": 225.3,
  "end": 226.3,
  "text": "找一個好的女人"
 },
 {
  "start": 226.3,
  "end": 229.7,
  "text": "結婚很難"
 },
 {
  "start": 229.7,
  "end": 233.0,
  "text": "那些要錢的女人"
 },
 {
  "start": 233.0,
  "end": 235.0,
  "text": "掉了也沒什麼用"
 },
 {
  "start": 235.0,
  "end": 237.0,
  "text": "人家根本不想"
 },
 {
  "start": 237.0,
  "end": 239.0,
  "text": "跟你過夜去"
 },
 {
  "start": 239.0,
  "end": 241.0,
  "text": "所以找那些要錢的女人"
 },
 {
  "start": 241.0,
  "end": 243.0,
  "text": "沒用"
 },
 {
  "start": 243.0,
  "end": 245.0,
  "text": "找一個好的女人"
 },
 {
  "start": 245.0,
  "end": 247.0,
  "text": "難找"
 },
 {
  "start": 247.0,
  "end": 250.0,
  "text": "打光棍了這麼多年了"
 },
 {
  "start": 250.0,
  "end": 252.4,
  "text": "太難了"
 }
